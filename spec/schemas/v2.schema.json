{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/buchwandler/utterplan/schema/v2",
  "title": "UtterPlan schema",
  "type": "object",
  "required": [
    "format",
    "schema_version",
    "producer",
    "plan_id",
    "source",
    "config",
    "texts",
    "preparation",
    "languages",
    "linguistic_runs",
    "annotations",
    "boundaries",
    "tokens",
    "segments",
    "units",
    "markers",
    "warnings",
    "diagnostics"
  ],
  "properties": {
    "format": { "const": "utterplan" },
    "schema_version": { "const": 2 },
    "producer": {
      "type": "object",
      "required": ["name", "version"],
      "properties": {
        "name": { "type": "string" },
        "version": { "type": "string" }
      },
      "additionalProperties": true
    },
    "plan_id": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "source": { "$ref": "#/$defs/source" },
    "config": { "type": "object" },
    "texts": {
      "type": "object",
      "required": ["structural", "spoken"],
      "properties": {
        "structural": { "type": "string" },
        "spoken": { "type": "string" }
      },
      "additionalProperties": false
    },
    "preparation": { "$ref": "#/$defs/preparation" },
    "languages": { "type": "array", "items": { "$ref": "#/$defs/language" } },
    "linguistic_runs": { "type": "array", "items": { "$ref": "#/$defs/linguistic_run" } },
    "annotations": {
      "type": "array",
      "items": { "$ref": "#/$defs/annotation" }
    },
    "boundaries": { "type": "array", "items": { "$ref": "#/$defs/boundary" } },
    "tokens": { "type": "array", "items": { "$ref": "#/$defs/token" } },
    "segments": { "type": "array", "items": { "$ref": "#/$defs/segment" } },
    "units": { "type": "array", "items": { "$ref": "#/$defs/unit" } },
    "markers": { "type": "array", "items": { "$ref": "#/$defs/marker" } },
    "document_metadata": {
      "type": "object",
      "properties": {
        "language_detection": { "$ref": "#/$defs/language_detection" }
      },
      "additionalProperties": true
    },
    "warnings": { "type": "array", "items": { "type": "string" } },
    "diagnostics": {
      "type": "array",
      "items": { "$ref": "#/$defs/diagnostic" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "source": {
      "type": "object",
      "required": ["format", "text"],
      "properties": {
        "format": { "enum": ["plain", "ssmd"] },
        "text": { "type": "string" }
      },
      "additionalProperties": false
    },
    "preparation": {
      "type": "object",
      "required": ["backend", "languages", "replacements", "warnings"],
      "properties": {
        "backend": { "type": "string" },
        "version": { "type": ["string", "null"] },
        "languages": { "type": "array", "items": { "type": "string" } },
        "replacements": { "type": "array", "items": { "type": "object" } },
        "warnings": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "range": { "type": "integer", "minimum": 0 },
    "language_detection": {
      "type": "object",
      "required": ["mode", "languages"],
      "properties": {
        "mode": { "type": "string", "minLength": 1 },
        "languages": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "additionalProperties": false
    },
    "language": {
      "type": "object",
      "required": ["id", "spoken_start", "spoken_end", "language", "source"],
      "properties": {
        "id": { "type": "string" },
        "spoken_start": { "$ref": "#/$defs/range" },
        "spoken_end": { "$ref": "#/$defs/range" },
        "language": { "type": "string" },
        "source": { "type": "string" }
      },
      "additionalProperties": false
    },
    "linguistic_run": {
      "type": "object",
      "required": ["language_run_id", "provider", "token_start", "token_end", "model", "provider_version", "model_version"],
      "properties": {
        "language_run_id": { "type": "string" },
        "provider": { "enum": ["spacy", "fallback", "unknown"] },
        "token_start": { "type": "integer", "minimum": 0 },
        "token_end": { "type": "integer", "minimum": 0 },
        "model": { "type": ["string", "null"] },
        "provider_version": { "type": ["string", "null"] },
        "model_version": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "annotation": {
      "type": "object",
      "required": [
        "id",
        "structural_start",
        "structural_end",
        "spoken_start",
        "spoken_end",
        "kind",
        "attrs"
      ],
      "properties": {
        "id": { "type": "string" },
        "structural_start": { "$ref": "#/$defs/range" },
        "structural_end": { "$ref": "#/$defs/range" },
        "spoken_start": { "type": ["integer", "null"], "minimum": 0 },
        "spoken_end": { "type": ["integer", "null"], "minimum": 0 },
        "kind": { "type": "string" },
        "attrs": { "type": "object" }
      },
      "additionalProperties": false
    },
    "boundary": {
      "type": "object",
      "required": ["id", "position", "kind", "seconds", "origin", "strength"],
      "properties": {
        "id": { "type": "string" },
        "position": { "$ref": "#/$defs/range" },
        "kind": { "type": "string" },
        "seconds": { "type": ["number", "null"], "minimum": 0 },
        "origin": { "type": "string" },
        "strength": { "type": ["string", "null"] },
        "attrs": { "type": "object" }
      },
      "additionalProperties": false
    },
    "token": {
      "type": "object",
      "required": ["spoken_start", "spoken_end", "text"],
      "properties": {
        "id": { "type": "string" },
        "spoken_start": { "$ref": "#/$defs/range" },
        "spoken_end": { "$ref": "#/$defs/range" },
        "text": { "type": "string" },
        "pos": { "type": ["string", "null"] },
        "tag": { "type": ["string", "null"] },
        "lemma": { "type": ["string", "null"] },
        "language": { "type": ["string", "null"] },
        "morph": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "pause": {
      "type": "object",
      "required": ["seconds", "events"],
      "properties": {
        "seconds": { "type": "number", "minimum": 0 },
        "events": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "directives": {
      "type": "object",
      "properties": {
        "voice": { "type": ["object", "null"] },
        "pronunciation": { "type": ["object", "null"] },
        "prosody": { "type": ["object", "null"] },
        "emphasis": { "type": ["object", "null"] },
        "audio": { "type": ["object", "null"] }
      },
      "additionalProperties": false
    },
    "segment": {
      "type": "object",
      "required": [
        "id",
        "text",
        "spoken_start",
        "spoken_end",
        "language",
        "paragraph",
        "sentence",
        "clause",
        "pause_before",
        "pause_after",
        "directives",
        "token_indices",
        "annotation_ids"
      ],
      "properties": {
        "id": { "type": "string" },
        "text": { "type": "string" },
        "spoken_start": { "$ref": "#/$defs/range" },
        "spoken_end": { "$ref": "#/$defs/range" },
        "language": { "type": "string" },
        "paragraph": { "type": "integer", "minimum": 0 },
        "sentence": { "type": "integer", "minimum": 0 },
        "clause": { "type": "integer", "minimum": 0 },
        "structural_start": { "type": ["integer", "null"], "minimum": 0 },
        "structural_end": { "type": ["integer", "null"], "minimum": 0 },
        "pause_before": { "$ref": "#/$defs/pause" },
        "pause_after": { "$ref": "#/$defs/pause" },
        "directives": { "$ref": "#/$defs/directives" },
        "token_indices": {
          "type": "array",
          "items": { "type": "integer", "minimum": 0 }
        },
        "annotation_ids": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "unit": {
      "type": "object",
      "required": [
        "id",
        "index",
        "kind",
        "spoken_start",
        "spoken_end",
        "segment_ids",
        "marker_ids",
        "content_hash",
        "content_hash_schema"
      ],
      "properties": {
        "id": { "type": "string" },
        "index": { "type": "integer", "minimum": 0 },
        "kind": { "enum": ["paragraph", "sentence"] },
        "spoken_start": { "$ref": "#/$defs/range" },
        "spoken_end": { "$ref": "#/$defs/range" },
        "segment_ids": { "type": "array", "items": { "type": "string" } },
        "marker_ids": { "type": "array", "items": { "type": "string" } },
        "content_hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "content_hash_schema": { "const": "utterplan-unit-v2" }
      },
      "additionalProperties": false
    },
    "marker": {
      "type": "object",
      "required": ["id", "name", "spoken_position"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "spoken_position": { "$ref": "#/$defs/range" },
        "attrs": { "type": "object" }
      },
      "additionalProperties": false
    },
    "diagnostic": {
      "type": "object",
      "required": ["code", "message", "severity", "path"],
      "properties": {
        "code": { "type": "string" },
        "message": { "type": "string" },
        "severity": { "type": "string" },
        "path": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    }
  }
}
