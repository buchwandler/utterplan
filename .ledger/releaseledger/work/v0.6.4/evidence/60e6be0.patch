+
+
+@pytest.mark.parametrize(
+    ("field", "manifest_key", "value", "message"),
+    [
+        ("document_id", "id", "other-document", "document.id"),
+        ("path", "path", "other.ssmd.md", "document.path"),
+        ("sha256", "sha256", "A" * 64, "sha256"),
