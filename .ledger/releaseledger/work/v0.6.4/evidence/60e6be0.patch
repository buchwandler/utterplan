diff --git a/utterplan/document_workspace.py b/utterplan/document_workspace.py
new file mode 100644
index 0000000..b15cd13
--- /dev/null
+++ b/utterplan/document_workspace.py
@@ -0,0 +1,194 @@
+"""Orchestration services for compiling editable SSMDDoc workspaces."""
+
+from __future__ import annotations
+
+from collections.abc import Callable
+from dataclasses import dataclass
+from pathlib import Path
+from typing import Literal
+
+from .batch import BatchProgressCallback, CompileOutcome, CompileRequest, compile_to_files
+from .config import PlannerConfig
+from .ssmdoc import SSMDDocError, load_ssmdoc_index, ssmdoc_document_path
+
+
+class DocumentWorkspaceServiceError(ValueError):
+    """A document workspace request is invalid or unsafe to execute."""
+
+
+@dataclass(frozen=True, slots=True)
+class DocumentCompileRequest:
+    """Options for compiling one editable SSMDDoc workspace."""
+
+    workspace: Path
+    output_dir: Path | None = None
+    report: Path | None = None
+    language: str | None = None
+    force: bool = False
+    diagnostics: Literal["errors", "warnings", "all", "none"] = "errors"
+    planner_config: PlannerConfig | None = None
+
+    def __post_init__(self) -> None:
+        object.__setattr__(self, "workspace", Path(self.workspace))
+        if self.output_dir is not None:
+            object.__setattr__(self, "output_dir", Path(self.output_dir))
+        if self.report is not None:
+            object.__setattr__(self, "report", Path(self.report))
+        if self.diagnostics not in {"errors", "warnings", "all", "none"}:
+            raise ValueError("diagnostics must be 'errors', 'warnings', 'all', or 'none'")
+
+
+@dataclass(frozen=True, slots=True)
+class DocumentCompileStart:
+    """Resolved document source and artifact locations announced before compilation."""
+
+    workspace: Path
+    document_id: str
+    source_path: Path
+    output_dir: Path
+    report_path: Path
+    dirty: bool | None = None
+
+
+@dataclass(frozen=True, slots=True)
+class DocumentCompileResult:
+    """Resolved artifacts and the single document compilation outcome."""
+
+    workspace: Path
+    document_id: str
+    source_path: Path
+    output_dir: Path
+    plan_path: Path
+    report_path: Path
+    outcome: CompileOutcome
+
+    @property
+    def failed(self) -> int:
+        return int(self.outcome.status == "failed")
+
+    @property
+    def exit_code(self) -> int:
+        return 1 if self.failed else 0
+
+
+DocumentCompileStartCallback = Callable[[DocumentCompileStart], None]
+
+
+def compile_ssmdoc(
+    workspace: str | Path,
+    *,
+    output_dir: str | Path | None = None,
+    report: str | Path | None = None,
+    language: str | None = None,
+    planner_config: PlannerConfig | None = None,
+    force: bool = False,
+    diagnostics: Literal["errors", "warnings", "all", "none"] = "errors",
+    on_progress: BatchProgressCallback | None = None,
+    on_start: DocumentCompileStartCallback | None = None,
+) -> DocumentCompileResult:
+    """Compile the current canonical SSMD document and write a one-item report."""
+    request = DocumentCompileRequest(
+        workspace=Path(workspace),
+        output_dir=Path(output_dir) if output_dir is not None else None,
+        report=Path(report) if report is not None else None,
+        language=language,
+        planner_config=planner_config,
+        force=force,
+        diagnostics=diagnostics,
+    )
+    try:
+        index = load_ssmdoc_index(request.workspace)
+        source_path = ssmdoc_document_path(index)
+    except SSMDDocError as exc:
+        raise DocumentWorkspaceServiceError(str(exc)) from exc
+
+    output_path = request.output_dir or (index.root / ".readio" / "utterplan")
+    plan_path = output_path / f"{index.document_id}.utterplan.toml"
+    report_path = request.report or (output_path / "compile-report.toml")
+    _preflight_outputs(index.manifest_path, source_path, output_path, plan_path, report_path)
+
+    compile_request = CompileRequest(
+        id=index.document_id,
+        source=source_path,
+        output=plan_path,
+        input_format="ssmd",
+        fallback_language=request.language,
+        source_label=str(source_path),
+        require_language=request.language is None,
+    )
+    config = request.planner_config or PlannerConfig(language=request.language or "en-US")
+    if on_start is not None:
+        on_start(
+            DocumentCompileStart(
+                workspace=index.root,
+                document_id=index.document_id,
+                source_path=source_path,
+                output_dir=output_path,
+                report_path=report_path,
+            )
+        )
+
+    outcomes = tuple(
+        compile_to_files(
+            [compile_request],
+            config=config,
+            fail_fast=False,
+            force=request.force,
+            report_path=report_path,
+            on_progress=on_progress,
+        )
+    )
+    outcome = outcomes[0]
+    return DocumentCompileResult(
+        workspace=index.root,
+        document_id=index.document_id,
+        source_path=source_path,
+        output_dir=output_path,
+        plan_path=plan_path,
+        report_path=report_path,
+        outcome=outcome,
+    )
+
+
+def _preflight_outputs(
+    manifest_path: Path,
+    source_path: Path,
+    output_dir: Path,
+    plan_path: Path,
+    report_path: Path,
+) -> None:
+    resolved_manifest = manifest_path.resolve(strict=False)
+    resolved_source = source_path.resolve(strict=False)
+    resolved_plan = plan_path.expanduser().resolve(strict=False)
+    resolved_report = report_path.expanduser().resolve(strict=False)
+
+    if resolved_plan == resolved_report:
+        raise DocumentWorkspaceServiceError(
+            f"document report path collides with plan output: {report_path}"
+        )
+    for output in (resolved_plan, resolved_report):
+        if output in {resolved_manifest, resolved_source}:
+            raise DocumentWorkspaceServiceError(
+                f"document output would overwrite source workspace content: {output}"
+            )
+
+    expanded_output_dir = output_dir.expanduser()
+    if expanded_output_dir.exists() and not expanded_output_dir.is_dir():
+        raise DocumentWorkspaceServiceError(
+            f"document output directory is not a directory: {expanded_output_dir}"
+        )
+    for output_path in (plan_path, report_path):
+        if output_path.exists() and output_path.is_dir():
+            raise DocumentWorkspaceServiceError(
+                f"document output path is a directory when a file is expected: {output_path}"
+            )
+
+
+__all__ = [
+    "DocumentCompileRequest",
+    "DocumentCompileResult",
+    "DocumentCompileStart",
+    "DocumentCompileStartCallback",
+    "DocumentWorkspaceServiceError",
+    "compile_ssmdoc",
+]
diff --git a/utterplan/source_input.py b/utterplan/source_input.py
new file mode 100644
index 0000000..7873e0c
--- /dev/null
+++ b/utterplan/source_input.py
@@ -0,0 +1,121 @@
+"""Centralized path loading for standalone documents and SSMDDoc workspaces."""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+from pathlib import Path
+from typing import Literal
+
+from .compiler import InputFormat
+from .ssmdoc import SSMDDocError, load_ssmdoc_index, ssmdoc_document_path
+
+RequestedInputFormat = Literal["auto", "plain", "ssmd"]
+
+
+class SourceInputError(ValueError):
+    """A source path is unsupported or conflicts with its declared format."""
+
+
+@dataclass(frozen=True, slots=True)
+class LoadedSourceInput:
+    """Decoded source text and its resolved format/path provenance."""
+
+    text: str
+    input_format: InputFormat
+    source_path: Path
+    source_label: str
+    workspace_root: Path | None = None
+    workspace_kind: Literal["ssmdoc"] | None = None
+
+
+def load_source_path(
+    path: str | Path,
+    *,
+    requested_format: RequestedInputFormat = "auto",
+) -> LoadedSourceInput:
+    """Read a source file or current document from an SSMDDoc workspace."""
+    input_path = Path(path).expanduser()
+    workspace_root: Path | None = None
+    workspace_kind: Literal["ssmdoc"] | None = None
+
+    if input_path.is_dir():
+        try:
+            index = load_ssmdoc_index(input_path)
+            source_path = ssmdoc_document_path(index)
+        except SSMDDocError as exc:
+            raise SourceInputError(f"unsupported source directory {input_path}: {exc}") from exc
+        workspace_root = index.root
+        workspace_kind = "ssmdoc"
+    elif input_path.name == "document.ssmd.md" and _manifest_exists(input_path.parent):
+        index = load_ssmdoc_index(input_path)
+        source_path = ssmdoc_document_path(index)
+        workspace_root = index.root
+        workspace_kind = "ssmdoc"
+    else:
+        source_path = input_path
+        if not source_path.is_file():
+            raise SourceInputError(f"source path is not a regular file: {source_path}")
+
+    if workspace_kind is not None:
+        if requested_format == "plain":
+            raise SourceInputError(
+                "SSMDDoc workspace input is SSMD; --input-format plain is not supported"
+            )
+        input_format: InputFormat = "ssmd"
+    else:
+        text = source_path.read_text(encoding="utf-8")
+        input_format = _format_for_path(source_path, text, requested_format)
+        return LoadedSourceInput(
+            text=text,
+            input_format=input_format,
+            source_path=source_path,
+            source_label=str(source_path),
+        )
+
+    text = source_path.read_text(encoding="utf-8")
+    return LoadedSourceInput(
+        text=text,
+        input_format=input_format,
+        source_path=source_path,
+        source_label=str(source_path),
+        workspace_root=workspace_root,
+        workspace_kind=workspace_kind,
+    )
+
+
+def _manifest_exists(root: Path) -> bool:
+    manifest_path = root / "manifest.json"
+    return manifest_path.exists() or manifest_path.is_symlink()
+
+
+def _format_for_path(
+    path: Path, source: str, requested_format: RequestedInputFormat
+) -> InputFormat:
+    if requested_format != "auto":
+        return requested_format
+    lower_name = path.name.lower()
+    if lower_name.endswith((".ssmd.md", ".ssmd")):
+        return "ssmd"
+    if path.suffix.lower() == ".md" and _declares_ssmd_version(source):
+        return "ssmd"
+    return "plain"
+
+
+def _declares_ssmd_version(source: str) -> bool:
+    try:
+        from ssmd.frontmatter import FrontMatterError, parse_front_matter
+    except ImportError:
+        return False
+    try:
+        front_matter = parse_front_matter(source)
+    except FrontMatterError:
+        return False
+    return front_matter.present and "ssmd_version" in front_matter.data
+
+
+__all__ = [
+    "LoadedSourceInput",
+    "RequestedInputFormat",
+    "SourceInputError",
+    "load_source_path",
+]
diff --git a/utterplan/ssmdoc.py b/utterplan/ssmdoc.py
new file mode 100644
index 0000000..05185a8
--- /dev/null
+++ b/utterplan/ssmdoc.py
@@ -0,0 +1,191 @@
+"""Read-only discovery and safe path resolution for editable SSMDDoc workspaces."""
+
+from __future__ import annotations
+
+import json
+import re
+from dataclasses import dataclass
+from pathlib import Path, PurePosixPath, PureWindowsPath
+from typing import Any
+
+_DOCUMENT_FORMAT = "ssmdconvert.document"
+_DOCUMENT_SCHEMA_VERSION = 1
+_SSMD_VERSION = "0.9"
+_DOCUMENT_ID = "document-0001"
+_DOCUMENT_PATH = "document.ssmd.md"
+_MAX_MANIFEST_BYTES = 2 * 1024 * 1024
+_MAX_DOCUMENT_BYTES = 64 * 1024 * 1024
+_SHA256_RE = re.compile(r"[0-9a-f]{64}\Z")
+
+
+class SSMDDocError(ValueError):
+    """An SSMDDoc workspace is invalid or unsafe."""
+
+
+@dataclass(frozen=True, slots=True)
+class SSMDDocIndex:
+    """Validated, read-only document-workspace manifest data."""
+
+    root: Path
+    manifest_path: Path
+    document_id: str
+    relative_path: str
+    expected_sha256: str
+    expected_char_count: int
+
+
+def resolve_ssmdoc_root(path: str | Path) -> Path:
+    """Resolve a manifest-authorized workspace root or its canonical document path."""
+    input_path = Path(path).expanduser()
+    try:
+        if input_path.is_dir():
+            root = input_path.resolve(strict=True)
+            if _has_document_manifest(root):
+                return root
+        elif input_path.name == _DOCUMENT_PATH and input_path.parent.is_dir():
+            root = input_path.parent.resolve(strict=True)
+            if _has_document_manifest(root):
+                return root
+    except SSMDDocError:
+        raise
+    except (OSError, RuntimeError) as exc:
+        raise SSMDDocError(f"cannot inspect ssmdoc input {input_path}: {exc}") from exc
+
+    raise SSMDDocError(
+        f"not an ssmdoc workspace: {path}\n"
+        "expected manifest.json with format 'ssmdconvert.document'"
+    )
+
+
+def load_ssmdoc_index(path: str | Path) -> SSMDDocIndex:
+    """Read and validate the public SSMDDoc v1 manifest without reading the document."""
+    root = resolve_ssmdoc_root(path)
+    manifest_path = root / "manifest.json"
+    data = _read_manifest(root)
+
+    if data.get("format") != _DOCUMENT_FORMAT:
+        raise SSMDDocError("unsupported ssmdoc format; expected 'ssmdconvert.document'")
+    schema_version = data.get("schema_version")
+    if type(schema_version) is not int or schema_version != _DOCUMENT_SCHEMA_VERSION:
+        raise SSMDDocError("unsupported ssmdoc schema_version; expected 1")
+    if data.get("ssmd_version") != _SSMD_VERSION:
+        raise SSMDDocError("unsupported ssmdoc ssmd_version; expected '0.9'")
+
+    document = data.get("document")
+    if not isinstance(document, dict):
+        raise SSMDDocError("ssmdoc manifest document must be an object")
+    document_id = document.get("id")
+    relative_path = document.get("path")
+    expected_sha256 = document.get("sha256")
+    expected_char_count = document.get("char_count")
+
+    if document_id != _DOCUMENT_ID:
+        raise SSMDDocError(f"unsupported ssmdoc document.id; expected '{_DOCUMENT_ID}'")
+    if not isinstance(relative_path, str) or not relative_path:
+        raise SSMDDocError(
+            "ssmdoc document.path must be a non-empty normalized relative POSIX path"
+        )
+    _validate_relative_document_path(relative_path)
+    if relative_path != _DOCUMENT_PATH:
+        raise SSMDDocError(f"unsupported ssmdoc document.path; expected '{_DOCUMENT_PATH}'")
+    if not isinstance(expected_sha256, str) or _SHA256_RE.fullmatch(expected_sha256) is None:
+        raise SSMDDocError("ssmdoc document.sha256 must be 64 lowercase hexadecimal characters")
+    if type(expected_char_count) is not int or expected_char_count < 0:
+        raise SSMDDocError("ssmdoc document.char_count must be a non-negative integer")
+
+    return SSMDDocIndex(
+        root=root,
+        manifest_path=manifest_path,
+        document_id=document_id,
+        relative_path=relative_path,
+        expected_sha256=expected_sha256,
+        expected_char_count=expected_char_count,
+    )
+
+
+def ssmdoc_document_path(index: SSMDDocIndex) -> Path:
+    """Return the canonical document path after enforcing containment and file safety."""
+    _validate_relative_document_path(index.relative_path)
+    if index.relative_path != _DOCUMENT_PATH:
+        raise SSMDDocError(f"unsupported ssmdoc document.path; expected '{_DOCUMENT_PATH}'")
+
+    try:
+        root = index.root.resolve(strict=True)
+        source = root.joinpath(*PurePosixPath(index.relative_path).parts)
+        resolved = source.resolve(strict=False)
+        resolved.relative_to(root)
+        exists_or_link = source.exists() or source.is_symlink()
+        if exists_or_link:
+            if not resolved.is_file():
+                raise SSMDDocError(f"ssmdoc document is not a regular file: {index.relative_path}")
+            if resolved.stat().st_size > _MAX_DOCUMENT_BYTES:
+                raise SSMDDocError("ssmdoc document.ssmd.md exceeds the 64 MiB size limit")
+    except SSMDDocError:
+        raise
+    except (OSError, RuntimeError, ValueError) as exc:
+        raise SSMDDocError(
+            f"ssmdoc document path escapes workspace root: {index.relative_path}"
+        ) from exc
+    return source
+
+
+def _has_document_manifest(root: Path) -> bool:
+    manifest_path = root / "manifest.json"
+    if not manifest_path.exists() and not manifest_path.is_symlink():
+        return False
+    data = _read_manifest(root)
+    return data.get("format") == _DOCUMENT_FORMAT
+
+
+def _read_manifest(root: Path) -> dict[str, Any]:
+    manifest_path = root / "manifest.json"
+    try:
+        resolved_manifest = manifest_path.resolve(strict=True)
+        resolved_manifest.relative_to(root)
+        if not resolved_manifest.is_file():
+            raise SSMDDocError(f"ssmdoc manifest is not a regular file: {manifest_path}")
+        if resolved_manifest.stat().st_size > _MAX_MANIFEST_BYTES:
+            raise SSMDDocError("ssmdoc manifest.json exceeds the 2 MiB size limit")
+        with resolved_manifest.open("rb") as stream:
+            raw = stream.read(_MAX_MANIFEST_BYTES + 1)
+    except SSMDDocError:
+        raise
+    except (OSError, RuntimeError, ValueError) as exc:
+        raise SSMDDocError(f"cannot read ssmdoc manifest {manifest_path}: {exc}") from exc
+
+    if len(raw) > _MAX_MANIFEST_BYTES:
+        raise SSMDDocError("ssmdoc manifest.json exceeds the 2 MiB size limit")
+    try:
+        data = json.loads(raw.decode("utf-8"), parse_constant=_reject_json_constant)
+    except (UnicodeDecodeError, json.JSONDecodeError, ValueError, RecursionError) as exc:
+        raise SSMDDocError(f"invalid ssmdoc manifest.json: {exc}") from exc
+    if not isinstance(data, dict):
+        raise SSMDDocError("ssmdoc manifest root must be a JSON object")
+    return data
+
+
+def _validate_relative_document_path(value: str) -> None:
+    if "\x00" in value:
+        raise SSMDDocError("ssmdoc document.path must not contain NUL")
+    if "\\" in value:
+        raise SSMDDocError("ssmdoc document.path must use normalized POSIX separators")
+    path = PurePosixPath(value)
+    if path.is_absolute() or PureWindowsPath(value).drive:
+        raise SSMDDocError("ssmdoc document.path must be a relative POSIX path")
+    if any(part in {".", ".."} for part in path.parts):
+        raise SSMDDocError("ssmdoc document.path must not contain '.' or '..' components")
+    if path.as_posix() != value:
+        raise SSMDDocError("ssmdoc document.path must be a normalized relative POSIX path")
+
+
+def _reject_json_constant(value: str) -> Any:
+    raise ValueError(f"non-standard JSON constant {value!r}")
+
+
+__all__ = [
+    "SSMDDocError",
+    "SSMDDocIndex",
+    "load_ssmdoc_index",
+    "resolve_ssmdoc_root",
+    "ssmdoc_document_path",
+]
