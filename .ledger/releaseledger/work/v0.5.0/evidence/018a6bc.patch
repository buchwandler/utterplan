+def test_rejects_empty_malformed_nonpositive_and_reversed_selectors(
+    tmp_path: Path, selector: str
+) -> None:
+    index = load_ssmdbook_index(_book(tmp_path, (1, 2, 5, 17)))
+
+    with pytest.raises(SSMDBookError):
