+
+
+def test_selected_invalid_ssmd_is_reported_and_later_chapters_continue(
+    tmp_path: Path, capsys: pytest.CaptureFixture[str]
+) -> None:
+    root = tmp_path / "partial.ssmdbook"
+    _write_book(
