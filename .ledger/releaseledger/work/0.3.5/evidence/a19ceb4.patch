+        result[index] = replace(
+            previous,
+            text=text[previous.spoken_start : whitespace_end],
+            spoken_end=whitespace_end,
+        )
+        result[index + 1] = replace(
+            following,
+            text=text[whitespace_end : following.spoken_end],
