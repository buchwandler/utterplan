+                    spoken_end=expanded_end,
+                )
+                if following is not None and expanded_end > punctuation.spoken_end:
+                    result[index + 1] = replace(
+                        following,
+                        text=text[expanded_end : following.spoken_end],
+                        spoken_start=expanded_end,
+                    )
+                del result[index]
