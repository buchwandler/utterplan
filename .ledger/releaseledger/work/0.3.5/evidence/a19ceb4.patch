+            if (
+                not _is_neutral_punctuation_text(previous.text)
+                and not gap.strip()
+                and previous.paragraph == punctuation.paragraph
+                and expansion_allowed(expanded_start, expanded_end)
+            ):
+                result[index - 1] = replace(
