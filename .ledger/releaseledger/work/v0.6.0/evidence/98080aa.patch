+def _fake_token_budget_chunks(plan: FlowPlan, budget: int) -> tuple[tuple[str, ...], ...]:
+    """Model a downstream counter; it deliberately does not use UtterPlan tokens."""
+    chunks: list[tuple[str, ...]] = []
+    pending: list[str] = []
+    count = 0
