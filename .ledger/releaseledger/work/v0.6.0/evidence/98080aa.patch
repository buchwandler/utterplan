+            segment_count = len(segment.text.split())
+            if pending and count + segment_count > budget:
+                chunks.append(tuple(pending))
+                pending = []
+                count = 0
+            pending.append(segment.text)
+            count += segment_count
+    if pending:
+        chunks.append(tuple(pending))
+    return tuple(chunks)
