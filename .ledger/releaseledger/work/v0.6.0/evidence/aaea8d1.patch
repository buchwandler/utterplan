+            speech.text[start:end] in {"one", "two", "three", "four"} for start, end in bundle.span
+        )
+
+
+def test_repeated_token_bisection_converges_without_rebuilding_prior_partition() -> None:
+    words = tuple("abcdefgh")
+    text = " ".join(words)
