+            repairs.append(
+                SegmentationRepair(
+                    "segmentation.cut_dropped",
+                    f"Dropped out-of-range {candidate.origin} cut at {position!r}",
+                    original_position=position if type(position) is int else None,
+                    origin=candidate.origin,
+                )
+            )
