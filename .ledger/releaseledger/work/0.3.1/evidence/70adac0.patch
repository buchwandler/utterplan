+def _validate_audio_topology(
+    annotations: tuple[AnnotationSpan, ...],
+    runs: tuple[LanguageRun, ...],
+    segments: list[PlanSegment],
+) -> None:
+    audio_annotations = _audio_annotations(annotations)
