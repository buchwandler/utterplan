+    root = tmp_path / "fallback-boundaries.ssmdbook"
+    _write_book(
+        root,
+        (5, 6),
+        contents={
+            5: _ssmd('[alpha]{emphasis="strong"}—beta'),
+            6: _ssmd('alpha—[beta]{emphasis="strong"}'),
+        },
+    )
+
+    result = main(["compile-book", str(root), "--chapters", "5-6"])
+    capsys.readouterr()
+
+    assert result == 0
+    output_dir = root / "utterplan"
